options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: USRP Sink/Source Style1 OFDM radar zero-Doppler range profile. Scheduled
      Unified OfdmBurstRx (Torch CUDA DSP).
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: usrp_ofdm_sink_source_dd
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ''
    window_size: 2000,2000
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [10, 10]
    rotation: 0
    state: enabled

blocks:
- name: RX_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: RX Gain
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '50'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2672, 532.0]
    rotation: 0
    state: enabled
- name: R_max
  id: variable
  parameters:
    comment: "\u6700\u5927\u4E0D\u6A21\u7CCA\u8DDD\u79BB (m)\uFF0CR = c/(2\xB7BW)\xB7\
      N_fft"
    value: 3e8/2/samp_rate*fft_len
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 8.0]
    rotation: 0
    state: enabled
- name: TX_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: TX Gain
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '50'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2552, 532.0]
    rotation: 0
    state: enabled
- name: burst_len_samples
  id: variable
  parameters:
    comment: CPI time-domain samples; num_symbols * (fft_len + cp_len)
    value: num_symbols * (fft_len + cp_len)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 8.0]
    rotation: 0
    state: enabled
- name: cp_len
  id: variable
  parameters:
    comment: Cyclic prefix length (samples); ~78 m round-trip @ 245.76 MHz
    value: '128'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 280.0]
    rotation: 0
    state: enabled
- name: factor
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.001'
    stop: '1'
    value: '0.008'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1624, 4.0]
    rotation: 0
    state: enabled
- name: fft_len
  id: variable
  parameters:
    comment: ''
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 272.0]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: "\u8F7D\u9891 (Hz)\uFF1B\u987B\u4E0E v_max \u516C\u5F0F\u4E00\u81F4\uFF0C\
      \u5426\u5219\u901F\u5EA6\u4F30\u8BA1\u4F1A\u504F"
    value: 6.0e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1472, 16.0]
    rotation: 0
    state: enabled
- name: idle_ms
  id: variable
  parameters:
    comment: TX burst idle gap (ms); aids RX re-sync between CPIs
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2048, 544.0]
    rotation: 0
    state: enabled
- name: length_tag_key
  id: variable
  parameters:
    comment: ''
    value: '"packet_len"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 16.0]
    rotation: 0
    state: enabled
- name: min_out_buf_val
  id: variable
  parameters:
    comment: ''
    value: packet_len*2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1280, 16.0]
    rotation: 0
    state: enabled
- name: music_enable
  id: variable_qtgui_check_box
  parameters:
    comment: Enable 1D range MUSIC super-resolution on CPI complex range profile (dev0+dev1)
    'false': 'False'
    gui_hint: 0,4,1,1
    label: MUSIC Enable
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 124.0]
    rotation: 0
    state: enabled
- name: n_carriers
  id: variable
  parameters:
    comment: ''
    value: fft_len - 2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [312, 272.0]
    rotation: 0
    state: enabled
- name: num_delay_samp
  id: variable_qtgui_range
  parameters:
    comment: Recalibrate after fft_len/rate change; align loopback peak to 0 m
    gui_hint: ''
    label: Number of delayed samples
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: packet_len
    value: '277'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2360, 532.0]
    rotation: 0
    state: enabled
- name: num_symbols
  id: variable
  parameters:
    comment: CPI OFDM symbols per burst; 4 avoids qpsk>8192 sched limit at fft_len=2048
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 24.0]
    rotation: 0
    state: enabled
- name: packet_len
  id: variable
  parameters:
    comment: QPSK bytes per burst; derived from CPI symbol count
    value: num_symbols * n_carriers // 4
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 144.0]
    rotation: 0
    state: enabled
- name: range_bin_step
  id: variable
  parameters:
    comment: "\u8DDD\u79BB\u8C31\u6A2A\u8F74\u6B65\u8FDB (m/bin)\uFF1BGRC \u663E\u793A\
      \ 305.176m = 0.305 m"
    value: 3e8/(2*int(fft_len*subcarrier_spacing)*zeropadding_fac)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 8.0]
    rotation: 0
    state: enabled
- name: range_roi
  id: variable
  parameters:
    comment: ''
    value: (0.0, 3.5)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1152, 160.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: int(fft_len * subcarrier_spacing)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 272.0]
    rotation: 0
    state: enabled
- name: subcarrier_spacing
  id: variable
  parameters:
    comment: ''
    value: 120e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 272.0]
    rotation: 0
    state: enabled
- name: time_lead_s
  id: variable
  parameters:
    comment: Style1 tx_time lead (s); maps from wait_to_start
    value: wait_to_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2344, 704.0]
    rotation: 0
    state: enabled
- name: wait_to_start
  id: variable
  parameters:
    comment: ''
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2040, 640.0]
    rotation: 0
    state: enabled
- name: zeropadding_fac
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 128.0]
    rotation: 0
    state: enabled
- name: address
  id: parameter
  parameters:
    alias: ''
    comment: USRP 349B642; QSFP 10.2; external 10MHz+PPS
    hide: none
    label: address (349B642)
    short_id: ''
    type: str
    value: '"type=x4xx,serial=349B642,mgmt_addr=192.168.1.100,addr=192.168.10.2,clock_source=internal,time_source=internal"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2432, 348.0]
    rotation: 0
    state: enabled
- name: ofdm_burst_rx_0
  id: epy_block
  parameters:
    _source_code: 'from isac_imp.ofdm_burst_rx import OfdmBurstRxBlock


      blk = OfdmBurstRxBlock

      '
    affinity: ''
    alias: ''
    comment: 'Unified RX: Torch CUDA DSP + built-in plot/MUSIC'
    cp_len: cp_len
    device: '''cuda'''
    fft_len: fft_len
    length_tag_key: length_tag_key
    log_interval_s: '1.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    music_enable: music_enable
    num_delay_samp: num_delay_samp
    num_sources: '1'
    num_symbols: num_symbols
    range_bin_step: range_bin_step
    range_roi: range_roi
    subarray_size: '16'
    threshold: '0.1'
    zeropadding_fac: zeropadding_fac
  states:
    _io_cache: "('OFDM Burst RX', 'OfdmBurstRxBlock', [('fft_len', '2048'), ('cp_len',\
      \ '512'), ('num_symbols', '4'), ('zeropadding_fac', '4'), ('num_delay_samp',\
      \ '0'), ('device', \"'cuda'\"), ('length_tag_key', \"'packet_len'\"), ('log_interval_s',\
      \ '1.0'), ('range_roi', '(0.0, 30.0)'), ('range_bin_step', '0.305'), ('music_enable',\
      \ 'True'), ('num_sources', '1'), ('subarray_size', '16'), ('threshold', '0.1')],\
      \ [('0', 'complex', 1), ('tx_freq_cpi', 'message', 1), ('tx_schedule', 'message',\
      \ 1)], [], 'USRP IQ + TX \u9891\u57DF\u53C2\u8003 \u2192 Torch CUDA \u8DDD\u79BB\
      \u8C31 + \u5185\u7F6E plot/MUSIC\u3002', ['music_enable', 'num_delay_samp',\
      \ 'range_bin_step', 'range_roi'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 908.0]
    rotation: 0
    state: enabled
- name: ofdm_burst_tx_source_0
  id: epy_block
  parameters:
    _source_code: 'from isac_imp.ofdm_burst_tx_source import OfdmBurstTxSourceBlock


      blk = OfdmBurstTxSourceBlock

      '
    affinity: ''
    alias: ''
    comment: 'Unified TX: ResourceGrid + IFFT/CP + factor + Style1/sched'
    cp_len: cp_len
    device: '''cuda'''
    factor: factor
    fft_len: fft_len
    idle_ms: idle_ms
    length_tag_key: length_tag_key
    maxoutbuf: '0'
    minoutbuf: '0'
    num_bits_per_symbol: '2'
    num_delay_samp: num_delay_samp
    num_symbols: num_symbols
    samp_rate: float(samp_rate)
    scheduled_rx: 'True'
    seed: '42'
    subcarrier_spacing: subcarrier_spacing
    time_lead_s: time_lead_s
  states:
    _io_cache: "('OFDM Burst TX Source', 'OfdmBurstTxSourceBlock', [('fft_len', '2048'),\
      \ ('cp_len', '512'), ('num_symbols', '4'), ('subcarrier_spacing', '60000.0'),\
      \ ('num_bits_per_symbol', '2'), ('seed', '42'), ('device', \"'cpu'\"), ('factor',\
      \ '0.008'), ('length_tag_key', \"'packet_len'\"), ('time_lead_s', '0.5'), ('idle_ms',\
      \ '10.0'), ('samp_rate', '122880000.0'), ('scheduled_rx', 'True'), ('num_delay_samp',\
      \ '0')], [], [('0', 'complex', 1), ('tx_freq_cpi', 'message', 1), ('tx_schedule',\
      \ 'message', 1)], '\u9884\u8BA1\u7B97 CPI \u2192 \u65F6\u57DF Style1 IQ\uFF1B\
      \u9891\u57DF\u53C2\u8003\u7ECF\u6D88\u606F\u4E00\u6B21\u6027\u4E0B\u53D1\u3002\
      ', ['factor', 'idle_ms', 'num_delay_samp', 'samp_rate', 'scheduled_rx', 'time_lead_s'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 588.0]
    rotation: 0
    state: enabled
