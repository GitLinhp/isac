- name: scheduled_rx_bind_snippet
  id: snippet
  parameters:
    alias: ''
    code: 'import time

      from gnuradio import uhd

      now = time.time()

      self.uhd_usrp_sink_0.set_time_now(uhd.time_spec(now), uhd.ALL_MBOARDS)

      self.uhd_usrp_source_0.set_time_now(uhd.time_spec(now), uhd.ALL_MBOARDS)

      _maxn = max(16384, int(self.burst_len_samples))

      self.uhd_usrp_source_0.set_max_noutput_items(_maxn)

      self.uhd_usrp_source_0.set_min_output_buffer(max(int(self.min_out_buf_val),
      2 * int(self.burst_len_samples)))

      self.ofdm_burst_tx_source_0.set_min_output_buffer(0, max(2 * int(self.burst_len_samples),
      int(self.min_out_buf_val)))

      self.ofdm_burst_tx_source_0.bind_scheduled_rx(self.uhd_usrp_source_0)

      '
    comment: Bind USRP Source for scheduled NUM_SAMPS_AND_DONE RX
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 168.0]
    rotation: 0
    state: enabled
