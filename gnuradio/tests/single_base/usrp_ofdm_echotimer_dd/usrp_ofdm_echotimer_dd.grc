    comment: packet_len tags on scheduled RX bursts
    length_tag_key: length_tag_key
    maxoutbuf: '0'
    minoutbuf: '0'
    use_rx_time: 'True'
  states:
    _io_cache: "('Packet Len Tagger', 'PacketLenTaggerBlock', [('burst_len_samples', '10240'),\
      \ ('length_tag_key', \"'packet_len'\"), ('use_rx_time', 'True')], [('0', 'complex',\
      \ 1)], [('0', 'complex', 1)], '\u6bcf CPI \u6253 packet_len tag', ['burst_len_samples'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1520, 520.0]
    rotation: 0
    state: enabled
- name: echotimer_rx_compensator_0
