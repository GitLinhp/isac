options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: USRP Sink/Source Echotimer replacement OFDM radar zero-Doppler range profile. Scheduled
      RX (NUM_SAMPS_AND_DONE per CPI); packet_len via packet_len_tagger.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: usrp_ofdm_echotimer_dd
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ''
    window_size: 2000,2000
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [10, 10]
    rotation: 0
    state: enabled

blocks:
- name: RX_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: RX Gain
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '50'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2600, 492.0]
    rotation: 0
    state: enabled
- name: R_max
  id: variable
  parameters:
    comment: "\u6700\u5927\u4E0D\u6A21\u7CCA\u8DDD\u79BB (m)\uFF0CR = c/(2\xB7BW)\xB7\
      N_fft"
    value: 3e8/2/samp_rate*fft_len
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 16.0]
    rotation: 0
    state: enabled
- name: TX_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: TX Gain
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '50'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2480, 492.0]
    rotation: 0
    state: enabled
- name: burst_len_samples
  id: variable
  parameters:
    comment: CPI time-domain samples; transpose_len * (fft_len + fft_len//4)
    value: transpose_len * (fft_len + fft_len//4)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 8.0]
    rotation: 0
    state: enabled
- name: factor
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.001'
    stop: '1'
    value: '0.008'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1744, 44.0]
    rotation: 0
    state: enabled
- name: fft_len
  id: variable
  parameters:
    comment: ''
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 8.0]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: "\u8F7D\u9891 (Hz)\uFF1B\u987B\u4E0E v_max \u516C\u5F0F\u4E00\u81F4\uFF0C\
      \u5426\u5219\u901F\u5EA6\u4F30\u8BA1\u4F1A\u504F"
    value: 6.0e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1472, 16.0]
    rotation: 0
    state: enabled
- name: length_tag_key
  id: variable
  parameters:
    comment: ''
    value: '"packet_len"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 8.0]
    rotation: 0
    state: enabled
- name: min_out_buf_val
  id: variable
  parameters:
    comment: ''
    value: packet_len*2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 16.0]
    rotation: 0
    state: enabled
- name: music_enable
  id: variable_qtgui_check_box
  parameters:
    comment: Enable 1D range MUSIC super-resolution on CPI complex range profile (dev0+dev1)
    'false': 'False'
    gui_hint: 0,4,1,1
    label: MUSIC Enable
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1048, 148.0]
    rotation: 0
    state: enabled
- name: n_carriers
  id: variable
  parameters:
    comment: occupied subcarriers (full band minus DC); matches gr_setup.resolve_gr_carrier_tuples
    value: fft_len - 2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 128.0]
    rotation: 0
    state: enabled
- name: num_delay_samp
  id: variable_qtgui_range
  parameters:
    comment: Recalibrate after fft_len/rate change; align loopback peak to 0 m
    gui_hint: ''
    label: Number of delayed samples
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: packet_len
    value: '161'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2288, 492.0]
    rotation: 0
    state: enabled
- name: packet_len
  id: variable
  parameters:
    comment: QPSK bytes per burst; derived from CPI symbol count
    value: transpose_len * n_carriers // 4
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 16.0]
    rotation: 0
    state: enabled
- name: range_bin_step
  id: variable
  parameters:
    comment: "\u8DDD\u79BB\u8C31\u6A2A\u8F74\u6B65\u8FDB (m/bin)\uFF1BGRC \u663E\u793A\
      \ 305.176m = 0.305 m"
    value: 3e8/(2*int(fft_len*subcarrier_spacing)*zeropadding_fac)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 16.0]
    rotation: 0
    state: enabled
- name: range_roi
  id: variable
  parameters:
    comment: ''
    value: (0.0, 3.5)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1240, 176.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: int(fft_len * subcarrier_spacing)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 8.0]
    rotation: 0
    state: enabled
- name: subcarrier_spacing
  id: variable
  parameters:
    comment: ''
    value: 60e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 120.0]
    rotation: 0
    state: enabled
- name: transpose_len
  id: variable
  parameters:
    comment: CPI OFDM symbols per burst; 4 avoids qpsk>8192 sched limit at fft_len=2048
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [736, 8.0]
    rotation: 0
    state: enabled
- name: wait_to_start
  id: variable
  parameters:
    comment: ''
    value: '0.03'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2144, 488.0]
    rotation: 0
    state: enabled
- name: zeropadding_fac
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 128.0]
    rotation: 0
    state: enabled
- name: idle_ms
  id: variable
  parameters:
    comment: TX burst idle gap (ms); aids RX re-sync between CPIs
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2144, 560.0]
    rotation: 0
    state: enabled
- name: time_lead_s
  id: variable
  parameters:
    comment: Style1 tx_time lead (s); maps from wait_to_start
    value: wait_to_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2288, 560.0]
    rotation: 0
    state: enabled
- name: address
  id: parameter
  parameters:
    alias: ''
    comment: USRP 349B642; QSFP 10.2; external 10MHz+PPS
    hide: none
    label: address (349B642)
    short_id: ''
    type: str
    value: '"type=x4xx,serial=349B642,mgmt_addr=192.168.1.100,addr=192.168.10.2,clock_source=internal,time_source=internal"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2392, 348.0]
    rotation: 0
    state: enabled
- name: burst_iq_tag_rx_0
  id: epy_block
  parameters:
    _source_code: 'from isac_imp.burst_iq_tag_rx import BurstIqTagRxBlock


      blk = BurstIqTagRxBlock

      '
    affinity: ''
    alias: ''
    burst_len_samples: burst_len_samples
    comment: '(disabled) continuous RX fallback'
    length_tag_key: length_tag_key
    maxoutbuf: '0'
    minoutbuf: min_out_buf_val
    num_delay_samp: num_delay_samp
    samp_rate: float(samp_rate)
    idle_ms: idle_ms
    enable_stats_log: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1680, 520.0]
    rotation: 0
    state: disabled
- name: burst_iq_tag_tx_0
  id: epy_block
  parameters:
    _source_code: 'from isac_imp.burst_iq_tag_tx import BurstIqTagTxBlock


      blk = BurstIqTagTxBlock

      '
    affinity: ''
    alias: ''
    burst_len_samples: burst_len_samples
    comment: Style1 TX + scheduled UHD recv per CPI
    idle_ms: idle_ms
    length_tag_key: length_tag_key
    maxoutbuf: '0'
    minoutbuf: min_out_buf_val
    num_delay_samp: num_delay_samp
    samp_rate: float(samp_rate)
    scheduled_rx: 'True'
    time_lead_s: time_lead_s
  states:
    _io_cache: "('Burst IQ Tag TX', 'BurstIqTagTxBlock', [('burst_len_samples', '10240'),\
      \ ('length_tag_key', \"'packet_len'\"), ('time_lead_s', '0.2'), ('idle_ms', '10.0'),\
      \ ('samp_rate', '122880000.0'), ('scheduled_rx', 'True'), ('num_delay_samp', '161')],\
      \ [('0', 'complex', 1)], [('0', 'complex', 1)], 'Style1 TX + scheduled recv',\
      \ ['burst_len_samples', 'time_lead_s', 'idle_ms', 'samp_rate', 'scheduled_rx',\
      \ 'num_delay_samp'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1868, 368.0]
    rotation: 0
    state: enabled
- name: packet_len_tagger_0
  id: epy_block
