- name: scheduled_rx_bind_snippet
  id: snippet
  parameters:
    code: "import time\nfrom gnuradio import uhd\nnow = time.time()\nself.uhd_usrp_sink_0.set_time_now(uhd.time_spec(now),\
      \ uhd.ALL_MBOARDS)\nself.uhd_usrp_source_0.set_time_now(uhd.time_spec(now), uhd.ALL_MBOARDS)\nself.burst_iq_tag_tx_0.bind_scheduled_rx(self.uhd_usrp_source_0)\n"
    comment: Bind USRP Source for scheduled NUM_SAMPS_AND_DONE RX
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2000, 368.0]
    rotation: 0
    state: enabled
